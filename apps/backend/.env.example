# Copy to .env for local dev. In production, set these in your host's dashboard.

# Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mercor

# OpenAI Realtime (voice interview) and Gemini (scoring)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Production only: frontend origin(s) allowed by CORS, comma-separated.
# Leave unset locally to allow any origin.
# FRONTEND_URL=https://your-frontend.example.com

# Set automatically by most hosts; defaults to 3001.
# PORT=3001
